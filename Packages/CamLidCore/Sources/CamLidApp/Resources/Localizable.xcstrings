          }
        }
      }
    },
    "Battery safety limit reached. Connect power to start another timer.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chạm giới hạn an toàn của pin. Hãy cắm nguồn để bắt đầu hẹn giờ khác."
