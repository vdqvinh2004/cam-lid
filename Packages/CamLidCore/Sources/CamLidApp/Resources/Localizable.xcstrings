    "Activity stays on this Mac for 14 days; it never holds prompts, code or transcripts.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt động chỉ lưu trên Mac này trong 14 ngày; không bao giờ lưu lệnh, mã nguồn hay bản ghi hội thoại."
          }
