            "value": "Bluetooth đang hoạt động"
          }
        }
      }
    },
    "Brave Browser is active": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Brave Browser đang hoạt động"
          }
        }
      }
    },
    "CLI detected": {
      "localizations": {
        "vi": {
          "stringUnit": {
