    },
    "Agent state is unclear, so the Mac sleeps after the countdown.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trạng thái tác nhân chưa rõ, nên Mac sẽ ngủ sau khi đếm ngược."
          }
