    },
    "Agent tool failed; turn outcome is separate": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ của tác nhân lỗi; kết quả lượt được tính riêng"
          }
        }
      }
    },
    "Agent work is waiting until the lid opens.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công việc của tác nhân đang chờ đến khi mở nắp."
          }
        }
      }
    },
    "Agent: ": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác nhân: "
          }
        }
      }
    },
    "Agents": {
      "localizations": {
        "vi": {
          "stringUnit": {
