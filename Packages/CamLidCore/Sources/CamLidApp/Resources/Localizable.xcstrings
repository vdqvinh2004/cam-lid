        }
      }
    },
    "Battery safety limit: %lld min · %lld min remaining.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới hạn an toàn của pin: %lld phút · còn %lld phút."
