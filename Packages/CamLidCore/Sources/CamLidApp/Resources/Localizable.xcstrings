          "stringUnit": {
            "state": "translated",
            "value": "Giới hạn an toàn của pin: %lld phút. Hãy cắm nguồn để có hẹn giờ dài hơn."
          }
        }
      }
    },
    "Battery start level, waiting and CPU preferences": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức pin bắt đầu, thời gian chờ và tùy chọn CPU"
          }
        }
      }
    },
    "Battery time limit": {
      "localizations": {
