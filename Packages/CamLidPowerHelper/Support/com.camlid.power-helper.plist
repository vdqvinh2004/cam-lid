<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.camlid.power-helper</string>
    <key>BundleProgram</key><string>Contents/Library/LaunchServices/camlid-power-helper</string>
    <key>ProgramArguments</key><array><string>camlid-power-helper</string><string>--standard-v1</string></array>
    <key>MachServices</key><dict><key>com.camlid.power-helper</key><true/></dict>
