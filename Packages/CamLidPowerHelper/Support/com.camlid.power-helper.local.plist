<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.camlid.power-helper</string>
    <key>Program</key><string>/Library/PrivilegedHelperTools/com.camlid.power-helper</string>
    <key>ProgramArguments</key><array><string>/Library/PrivilegedHelperTools/com.camlid.power-helper</string><string>--standard-v1</string></array>
    <key>MachServices</key><dict><key>com.camlid.power-helper</key><true/></dict>
    <key>RunAtLoad</key><true/>
    <key>StandardOutPath</key><string>/var/log/com.camlid.power-helper.log</string>
    <key>StandardErrorPath</key><string>/var/log/com.camlid.power-helper.log</string>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>ProcessType</key><string>Adaptive</string>
</dict>
</plist>
